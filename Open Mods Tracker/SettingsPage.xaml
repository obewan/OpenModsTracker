<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenModsTracker.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenModsTracker"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal"  Margin="20">
        <ToggleSwitch x:Name="themeToggleSwitch" AutomationProperties.Name="themeToggleSwitch" OffContent="dark" 
                      OnContent="light"
                      Toggled="OnThemeSwitch_Toggled" ToolTipService.ToolTip="Toggle theme (changes will be apply on restart)" 
                      Loaded="OnThemeSwitch_Loaded"/>
        </StackPanel>
    </StackPanel>
</Page>
