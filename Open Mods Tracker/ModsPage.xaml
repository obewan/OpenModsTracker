<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenModsTracker.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenModsTracker"
    xmlns:converters="using:OpenModsTracker.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToBitmapImageConverter x:Key="StringToBitmapImageConverter" />
        <converters:StringNullOrWhitespaceToVisibilityConverter x:Key="StringNullOrWhitespaceToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28" Spacing="20">
            <Border Style="{StaticResource SectionCardStyle}">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="ModsPage_Title" Text="Portfolio" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Uid="ModsPage_Subtitle" Text="Toutes les fiches suivies, triées par performance de downloads puis endorsements." Opacity="0.72" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10" Orientation="Horizontal">
                        <TextBox x:Uid="ModsPage_Search"
                                 Width="240"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="ModsPage_Domain" Text="Jeu:" VerticalAlignment="Center" Opacity="0.68" />
                            <ComboBox ItemsSource="{Binding Domains}"
                                     SelectedItem="{Binding SelectedDomain, Mode=TwoWay}"
                                     Width="200"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="ModsPage_SortBy" Text="Trier par:" VerticalAlignment="Center" Opacity="0.68" />
                            <ComboBox SelectedIndex="{Binding SelectedSortIndex, Mode=TwoWay}" Width="160" VerticalAlignment="Center">
                                <ComboBoxItem x:Uid="ModsPage_SortDownloads" Content="Téléchargements" />
                                <ComboBoxItem x:Uid="ModsPage_SortEndorsements" Content="Endorsements" />
                            </ComboBox>
                        </StackPanel>
                        <Button x:Uid="HomePage_RefreshBtn" Content="Rafraichir" Click="RefreshButton_Click" IsEnabled="{Binding CanRefresh}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CollectionSummary}" Opacity="0.68" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar Title="Etat du portfolio" Message="{Binding StatusMessage}" IsOpen="{Binding HasStatusMessage}" Severity="Informational" IsClosable="False" />

            <ListView ItemsSource="{Binding Mods}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PortfolioMod">
                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="64"
                                        Height="64"
                                        CornerRadius="18"
                                        Background="#26FFFFFF"
                                        VerticalAlignment="Top"
                                        Margin="0,4,0,0">
                                    <Grid>
                                        <Image Stretch="UniformToFill"
                                               Source="{Binding PictureUrl, Converter={StaticResource StringToBitmapImageConverter}}" />
                                        <Border Background="#40000000"
                                                Visibility="{Binding PictureUrl, Converter={StaticResource StringNullOrWhitespaceToVisibilityConverter}}">
                                            <Viewbox>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            </Viewbox>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="22" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Reference.GameDomain}" Opacity="0.6" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayStatus}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" FontSize="12" TextLineBounds="Tight" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding DisplaySummary}" TextWrapping="WrapWholeWords" MaxLines="3" Opacity="0.8" />

                                    <Grid ColumnSpacing="16" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Downloads" Opacity="0.65" />
                                            <TextBlock Text="{Binding DisplayDownloads}" FontSize="20" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Unique DLs" Opacity="0.65" />
                                            <TextBlock Text="{Binding DisplayUniqueDownloads}" FontSize="20" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Endorsements" Opacity="0.65" />
                                            <TextBlock Text="{Binding DisplayEndorsements}" FontSize="20" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="18">
                                        <TextBlock Text="{Binding AuthorLabel}" />
                                        <TextBlock Text="{Binding DisplayVersion}" />
                                        <TextBlock Text="{Binding UpdatedAtLabel}" />
                                        <TextBlock Text="{Binding UploadedAtLabel}" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="2" x:Uid="OpenBtn" Content="Ouvrir sur Nexus" Tag="{Binding PageUrl}" Click="OpenModButton_Click" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
