<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenModsTracker.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenModsTracker"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28" Spacing="20">
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsPage_Title" Text="Parametres Nexus" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Uid="SettingsPage_GeneralInfo" Text="Configure la cle API personnelle et la liste des mods a suivre. Une ligne par mod, avec une URL Nexus ou le format game|id." Opacity="0.72" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <InfoBar Title="Configuration" Message="{Binding StatusMessage}" IsOpen="{Binding HasStatusMessage}" Severity="Informational" IsClosable="False" />

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock x:Uid="SettingsPage_General" Text="Général" FontSize="22" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Uid="SettingsPage_Theme" Text="Theme" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="themeToggleSwitch"
                                          OffContent="Dark"
                                          OnContent="Light"
                                          Toggled="OnThemeSwitch_Toggled"
                                          Loaded="OnThemeSwitch_Loaded" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Uid="SettingsPage_Language" Text="Langue" VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageComboBox" Width="150" SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem Content="English" Tag="en-US" />
                                <ComboBoxItem Content="Français" Tag="fr-FR" />
                                <ComboBoxItem Content="Español" Tag="es-ES" />
                                <ComboBoxItem Content="中文" Tag="zh-CN" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock x:Uid="SettingsPage_API" Text="Cle API" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Uid="SettingsPage_APIKeyInfo" Text="La cle personnelle se genere depuis la page API Access de Nexus Mods. Elle reste locale a l'application." Opacity="0.7" TextWrapping="WrapWholeWords" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ApiKeyPasswordBox"
                                     x:Uid="SettingsPage_APIKeyInput"
                                     PlaceholderText="Colle ici ta cle API Nexus"
                                     PasswordChanged="ApiKeyPasswordBox_PasswordChanged" />
                        <CheckBox Grid.Column="1"
                                  x:Name="RevealCheckBox"
                                  x:Uid="SettingsPage_RevealBtn"
                                  Content="Show"
                                  Checked="RevealModeCheckbox_Changed"
                                  Unchecked="RevealModeCheckbox_Changed" />
                        <Button Grid.Column="2" x:Uid="SettingsPage_SaveBtn" Content="Save" Click="SaveSettingsButton_Click" />
                        <Button Grid.Column="3" x:Uid="SettingsPage_TestBtn" Content="Test" Click="ValidateButton_Click" IsEnabled="{Binding CanValidate}" />
                    </Grid>
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource AppMutedBrush}" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="SettingsPage_Portfolio" Text="Portfolio de mods" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Uid="SettingsPage_PortfolioSub" Text="Exemples: `https://www.nexusmods.com/skyrimspecialedition/mods/12604` ou `fallout4|12345`." Opacity="0.7" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Uid="SettingsPage_SaveRefreshBtn" Content="Save and refresh" Click="SaveAndRefreshButton_Click" IsEnabled="{Binding CanValidate}" />
                    </Grid>

                    <TextBox x:Name="PortfolioTextBox"
                             AcceptsReturn="True"
                             MinHeight="220"
                             TextWrapping="Wrap"
                             VerticalAlignment="Stretch"
                             x:Uid="SettingsPage_PortfolioInput"
                             PlaceholderText="One mod URL per line"
                             TextChanged="PortfolioTextBox_TextChanged" />

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#1AFFFFFF" CornerRadius="18" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock x:Uid="SettingsPage_PortfolioSummaryLabel" Text="Resume de parsing" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PortfolioSummary}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="18" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock x:Uid="SettingsPage_AdviceLabel" Text="Conseil" FontWeight="SemiBold" />
                                <TextBlock x:Uid="SettingsPage_AdviceText" Text="Like the API publique documentee ne liste pas encore directement tous les mods d'un auteur, le portfolio sert de source de verite pour ton tableau de bord." TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock x:Uid="SettingsPage_ImportGraphQL" Text="Import GraphQL" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Uid="SettingsPage_ImportGraphQLInfo" Text="Your Nexus profile can now be imported automatically via the GraphQL v2 API. You can enter your Nexus username or a URL like `next.nexusmods.com/profile/...`." Opacity="0.7" TextWrapping="WrapWholeWords" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ImportProfileTextBox"
                                 x:Uid="SettingsPage_ImportProfileInput"
                                 PlaceholderText="Nexus username or profile URL" />
                        <Button Grid.Column="1"
                                x:Uid="SettingsPage_ImportBtn"
                                Content="Import my mods"
                                Click="ImportProfileButton_Click"
                                IsEnabled="{Binding CanValidate}" />
                    </Grid>
                    <TextBlock Text="{Binding ImportSummary}" Foreground="{StaticResource AppMutedBrush}" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
