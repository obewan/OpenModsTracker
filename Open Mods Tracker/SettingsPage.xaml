<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenModsTracker.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenModsTracker"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28" Spacing="20">
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="SettingsPage_Title" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Uid="SettingsPage_GeneralInfo" Opacity="0.72" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <InfoBar Title="Configuration" Message="{Binding StatusMessage}" IsOpen="{Binding HasStatusMessage}" Severity="Informational" IsClosable="False" />

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock x:Uid="SettingsPage_General" FontSize="22" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Uid="SettingsPage_Theme" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="themeToggleSwitch"
                                          OffContent="Dark"
                                          OnContent="Light"
                                          Toggled="OnThemeSwitch_Toggled"
                                          Loaded="OnThemeSwitch_Loaded" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Uid="SettingsPage_Language" VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageComboBox" Width="150" SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem Content="English" Tag="en-US" />                                
                                <ComboBoxItem Content="中文" Tag="zh-CN" />
                                <ComboBoxItem Content="Deutsch" Tag="de-DE" />
                                <ComboBoxItem Content="Español" Tag="es-ES" />
                                <ComboBoxItem Content="Français" Tag="fr-FR" />                                                                
                                <ComboBoxItem Content="Italiano" Tag="it-IT" />
                                <ComboBoxItem Content="日本語" Tag="ja-JP" />                                
                                <ComboBoxItem Content="Português" Tag="pt-BR" />
                                <ComboBoxItem Content="Русский" Tag="ru-RU" />
                                <ComboBoxItem Content="Nederlands" Tag="nl-NL" />                                
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock x:Uid="SettingsPage_API" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Uid="SettingsPage_APIKeyInfo" Opacity="0.7" TextWrapping="WrapWholeWords" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ApiKeyPasswordBox"
                                     x:Uid="SettingsPage_APIKeyInput"                                     
                                     PasswordChanged="ApiKeyPasswordBox_PasswordChanged" />
                        <CheckBox Grid.Column="1"
                                  x:Name="RevealCheckBox"
                                  x:Uid="SettingsPage_RevealBtn"
                                  Content="Show"
                                  Checked="RevealModeCheckbox_Changed"
                                  Unchecked="RevealModeCheckbox_Changed" />
                        <Button Grid.Column="2" x:Uid="SettingsPage_SaveBtn" Content="Save" Click="SaveSettingsButton_Click" />
                        <Button Grid.Column="3" x:Uid="SettingsPage_TestBtn" Content="Test" Click="ValidateButton_Click" IsEnabled="{Binding CanValidate}" />
                    </Grid>
                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource AppMutedBrush}" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Uid="SettingsPage_Portfolio" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Uid="SettingsPage_PortfolioSub" Opacity="0.7" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Uid="SettingsPage_SaveRefreshBtn" Content="Save and refresh" Click="SaveAndRefreshButton_Click" IsEnabled="{Binding CanValidate}" />
                    </Grid>

                    <TextBox x:Name="PortfolioTextBox"
                             AcceptsReturn="True"
                             MinHeight="220"
                             TextWrapping="Wrap"
                             VerticalAlignment="Stretch"
                             x:Uid="SettingsPage_PortfolioInput"
                             TextChanged="PortfolioTextBox_TextChanged" />

                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#1AFFFFFF" CornerRadius="18" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock x:Uid="SettingsPage_PortfolioSummaryLabel" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PortfolioSummary}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="18" Padding="18">
                            <StackPanel Spacing="8">
                                <TextBlock x:Uid="SettingsPage_AdviceLabel" FontWeight="SemiBold" />
                                <TextBlock x:Uid="SettingsPage_AdviceText" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="18">
                    <TextBlock x:Uid="SettingsPage_ImportGraphQL" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Uid="SettingsPage_ImportGraphQLInfo" Opacity="0.7" TextWrapping="WrapWholeWords" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ImportProfileTextBox"
                                 x:Uid="SettingsPage_ImportProfileInput" />
                        <Button Grid.Column="1"
                                x:Uid="SettingsPage_ImportBtn"
                                Content="Import my mods"
                                Click="ImportProfileButton_Click"
                                IsEnabled="{Binding CanValidate}" />
                    </Grid>
                    <TextBlock Text="{Binding ImportSummary}" Foreground="{StaticResource AppMutedBrush}" TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
